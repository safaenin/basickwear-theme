{%- doc -%}
  Renders a product price for product cards and product pages.
  @param {product} product_resource - Product to render
  @param {boolean} [show_unit_price] - Show unit price
  @param {boolean} [show_sale_price_first] - Show sale price first
{%- enddoc -%}

{% render 'price-styles' %}

<style>
  product-card { position: relative; }
  .price-sale-badge {
    position: absolute; left: 0; bottom: 88px; z-index: 20;
    display: inline-flex; align-items: center; justify-content: center;
    background: #d60000; color: #fff; font-size: 14px;
    font-weight: 700; line-height: 1; padding: 8px 12px;
    border: 0; border-radius: 0; letter-spacing: .2px;
    text-transform: uppercase; white-space: nowrap; pointer-events: none;
  }
  @media screen and (max-width: 749px) {
    .price-sale-badge { bottom: 78px; font-size: 12px; padding: 7px 10px; }
  }
  .bw-product-price { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .bw-product-price .bw-sale-price { color: #d00000; font-size: clamp(21px, 2.5vw, 27px); font-weight: 800; line-height: 1.2; }
  .bw-product-price .bw-original-price { color: #222; font-size: clamp(16px, 2vw, 20px); font-weight: 700; text-decoration: line-through; }
  .bw-product-price .bw-save-badge { display: inline-flex; align-items: center; background: #d00000; color: white; border-radius: 6px; padding: 5px 9px; font-size: 14px; font-weight: 800; line-height: 1.2; white-space: nowrap; }
</style>

{%- liquid
  assign show_unit_price = show_unit_price | default: false
  assign show_sale_price_first = show_sale_price_first | default: false
  assign selected_variant = product_resource.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_at_price = selected_variant.compare_at_price
  assign show_compare_price = false
  if compare_at_price > price
    assign show_compare_price = true
  endif
  if product_resource == blank
    assign price = 1999
  endif
  assign discount_percent = 0
  if compare_at_price > price
    assign discount_amount = compare_at_price | minus: price
    assign discount_percent = discount_amount | times: 100.0 | divided_by: compare_at_price | round
  endif
  assign has_volume_pricing = false
  assign price_min = null
  assign price_max = null
  assign is_product_card = false
  if template.name != 'product'
    assign is_product_card = true
  endif
  if is_product_card
    assign price_min = product_resource.price_min
    assign price_max = product_resource.price_max
    assign has_volume_pricing = product_resource.quantity_price_breaks_configured? | default: false
  else
    if selected_variant.quantity_price_breaks.size > 0
      assign has_volume_pricing = true
      assign price_min = selected_variant.quantity_price_breaks.last.price
      assign price_max = selected_variant.price
    endif
  endif
  assign use_currency = false
  if product.handle == product_resource.handle
    if settings.currency_code_enabled_product_pages
      assign use_currency = true
    endif
  elsif settings.currency_code_enabled_product_cards
    assign use_currency = true
  endif
  if use_currency
    assign price = price | money_with_currency
    assign compare_at_price = compare_at_price | money_with_currency
    assign price_min = price_min | money_with_currency
    assign price_max = price_max | money_with_currency
  else
    assign price = price | money
    assign compare_at_price = compare_at_price | money
    assign price_min = price_min | money
    assign price_max = price_max | money
  endif
-%}

<div ref="priceContainer">
  {% if is_product_card and show_compare_price and discount_percent > 0 %}
    <span class="price-sale-badge">SAVE {{ discount_percent }}%</span>
  {% endif %}

  {% if has_volume_pricing %}
    {% if show_compare_price %}
      <span class="price-item__group compare-at-price">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>{{- compare_at_price -}}
      </span>
    {% endif %}
    <span class="price-item__group price">
      <span class="visually-hidden">{{ 'content.price_range' | t }}&nbsp;</span>
      {{ price_min }} - {{ price_max }}
    </span>
  {% elsif is_product_card %}
    {% if show_compare_price %}
      {% if show_sale_price_first %}
        <span class="price-item__group price"><span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>{{ price | default: '&nbsp;' }}</span>
        <span class="price-item__group price-item--regular compare-at-price"><span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>{{- compare_at_price -}}</span>
      {% else %}
        <span class="price-item__group price-item--regular compare-at-price"><span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>{{- compare_at_price -}}</span>
        <span class="price-item__group price"><span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>{{ price | default: '&nbsp;' }}</span>
      {% endif %}
    {% else %}
      <span class="price">{{ price | default: '&nbsp;' }}</span>
    {% endif %}
  {% else %}
    <div class="bw-product-price">
      {% if show_compare_price %}
        <span class="bw-sale-price price" aria-label="Sale price">{{ price }}</span>
        <span class="bw-original-price compare-at-price" aria-label="Original price">{{ compare_at_price }}</span>
        {% if discount_percent > 0 %}<span class="bw-save-badge">SAVE {{ discount_percent }}%</span>{% endif %}
      {% else %}
        <span class="bw-sale-price price">{{ price | default: '&nbsp;' }}</span>
      {% endif %}
    </div>
  {% endif %}

  {%- if selected_variant.unit_price and show_unit_price -%}
    {%- liquid
      if use_currency
        assign unit_price = selected_variant.unit_price | money_with_currency
      else
        assign unit_price = selected_variant.unit_price | money
      endif
    -%}
    {% render 'unit-price', price: unit_price, measurement: selected_variant.unit_price_measurement %}
  {%- endif -%}
</div>

{%- if has_volume_pricing -%}
  <small ref="volumePricingNote" class="volume-pricing-note">{{- 'content.volume_pricing_available' | t -}}</small>
{%- endif -%}
