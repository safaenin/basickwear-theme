            "custom_liquid_GAXbqn": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<style>\n  /* BASICKWEAR PRODUCT TABS */\n  .bw-tabs {\n    width: 100%;\n    margin: 20px 0;\n    font-family: inherit;\n  }\n\n  .bw-tab-buttons {\n    display: flex;\n    width: 100%;\n    border-bottom: 1px solid #ddd;\n  }\n\n  .bw-tab-btn {\n    flex: 1;\n    min-width: 0;\n    background: transparent;\n    border: none;\n    border-bottom: 2px solid transparent;\n    padding: 14px 4px;\n    font-family: inherit;\n    font-size: 15px;\n    font-weight: 400;\n    color: #666;\n    cursor: pointer;\n    text-align: center;\n    transition: color .2s ease;\n  }\n\n  .bw-tab-btn.active {\n    color: #111;\n    border-bottom-color: #111;\n  }\n\n  /* TAB CONTENT */\n  .bw-tab-panel {\n    display: none;\n    padding: 18px 0;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 400;\n    line-height: 1.8;\n    letter-spacing: .2px;\n    color: #333;\n  }\n\n  .bw-tab-panel.active {\n    display: block;\n  }\n\n  .bw-tab-panel p {\n    margin: 0 0 16px;\n  }\n\n  /* EXCHANGE POLICY */\n  .bw-policy-content p {\n    margin: 0 0 22px;\n    font-size: 14px;\n    line-height: 1.85;\n    letter-spacing: .2px;\n  }\n\n  .bw-policy-content strong {\n    color: #111;\n    font-weight: 700;\n  }\n\n  .bw-policy-link {\n    margin-top: 24px !important;\n  }\n\n  .bw-policy-link a {\n    color: #111;\n    font-size: 13px;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .bw-policy-link a:hover {\n    color: #666;\n  }\n\n  /* MOBILE */\n  @media screen and (max-width: 749px) {\n    .bw-tabs {\n      margin: 15px 0;\n    }\n\n    .bw-tab-btn {\n      font-size: 12px;\n      padding: 12px 2px;\n    }\n\n    .bw-tab-panel {\n      padding: 16px 0;\n      font-size: 13px;\n      line-height: 1.75;\n    }\n\n    .bw-policy-content p {\n      font-size: 13px;\n      line-height: 1.8;\n      margin-bottom: 18px;\n    }\n\n    .bw-policy-link a {\n      font-size: 12px;\n    }\n  }\n</style>\n\n<div class=\"bw-tabs\" id=\"bw-tabs-{{ section.id }}\">\n\n  <!-- TAB BUTTONS -->\n  <div class=\"bw-tab-buttons\" role=\"tablist\">\n\n    <button\n      type=\"button\"\n      class=\"bw-tab-btn active\"\n      data-tab=\"description\"\n      role=\"tab\"\n      aria-selected=\"true\">\n      Description\n    </button>\n\n    <button\n      type=\"button\"\n      class=\"bw-tab-btn\"\n      data-tab=\"details\"\n      role=\"tab\"\n      aria-selected=\"false\">\n      Details\n    </button>\n\n    <button\n      type=\"button\"\n      class=\"bw-tab-btn\"\n      data-tab=\"exchange\"\n      role=\"tab\"\n      aria-selected=\"false\">\n      Exchange Policy\n    </button>\n\n  </div>\n\n  <!-- DESCRIPTION -->\n  <div class=\"bw-tab-panel active\"\n       data-panel=\"description\">\n\n    {{ product.description }}\n\n  </div>\n\n  <!-- PRODUCT DETAILS -->\n  <div class=\"bw-tab-panel\"\n       data-panel=\"details\">\n\n    <p><strong>Brand:</strong> BASICKWEAR</p>\n\n    <p><strong>Fit:</strong> Oversized / Relaxed</p>\n\n    <p><strong>Care:</strong> Machine wash cold, inside out.</p>\n\n    <p><strong>Note:</strong> Product details may vary by style.</p>\n\n  </div>\n\n  <!-- EXCHANGE POLICY -->\n  <div class=\"bw-tab-panel\"\n       data-panel=\"exchange\">\n\n    <div class=\"bw-policy-content\">\n\n      <p>\n        <strong>Returns</strong> –\n        Accepted only for defective, damaged,\n        incorrect or undelivered products.\n        Requests must be raised within 24 hours.\n      </p>\n\n      <p>\n        <strong>Refunds</strong> –\n        Approved returns are processed as\n        store credit, subject to our refund policy.\n      </p>\n\n      <p>\n        <strong>Exchanges</strong> –\n        Size exchanges are allowed within\n        24–48 hours of delivery, subject to\n        stock availability and applicable charges.\n      </p>\n\n      <p>\n        <strong>Important Notes</strong> –\n        Only one exchange is permitted per order.\n        Sale items are not eligible for\n        return or exchange.\n      </p>\n\n      {% if shop.refund_policy != blank %}\n        <p class=\"bw-policy-link\">\n          <a href=\"{{ shop.refund_policy.url }}\">\n            View Full Return & Exchange Policy →\n          </a>\n        </p>\n      {% endif %}\n\n    </div>\n\n  </div>\n\n</div>\n\n<script>\n(function () {\n\n  const tabs = document.getElementById(\n    'bw-tabs-{{ section.id }}'\n  );\n\n  if (!tabs || tabs.dataset.initialized) return;\n\n  tabs.dataset.initialized = 'true';\n\n  tabs.addEventListener('click', function(event) {\n\n    const button = event.target.closest('.bw-tab-btn');\n\n    if (!button || !tabs.contains(button)) return;\n\n    const selected = button.dataset.tab;\n\n    tabs.querySelectorAll('.bw-tab-btn').forEach(function(btn) {\n\n      const active = btn === button;\n\n      btn.classList.toggle('active', active);\n\n      btn.setAttribute(\n        'aria-selected',\n        String(active)\n      );\n\n    });\n\n    tabs.querySelectorAll('.bw-tab-panel').forEach(function(panel) {\n\n      panel.classList.toggle(\n        'active',\n        panel.dataset.panel === selected\n      );\n\n    });\n\n  });\n\n})();\n</script>"
