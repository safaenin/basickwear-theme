            "custom_liquid_WFHArW": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<style>\n  /* BASICKWEAR SIZING CHART */\n  .bw-size-info {\n    margin: 8px 0 12px;\n    font-family: inherit;\n  }\n\n  .bw-size-chart summary {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    cursor: pointer;\n    font-size: 18px;\n    font-weight: 400;\n    list-style: none;\n  }\n\n  .bw-size-chart summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .bw-size-chart table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-top: 12px;\n    font-size: 13px;\n    text-align: center;\n  }\n\n  .bw-size-chart th,\n  .bw-size-chart td {\n    border: 1px solid #ddd;\n    padding: 10px 6px;\n  }\n\n  .bw-model-details {\n    font-size: 18px;\n    font-weight: 400;\n    line-height: 1.4;\n    margin-top: 6px;\n  }\n\n  @media (max-width: 749px) {\n    .bw-size-chart summary,\n    .bw-model-details {\n      font-size: 16px;\n    }\n  }\n</style>\n\n<div class=\"bw-size-info\">\n\n  <details class=\"bw-size-chart\">\n    <summary>\n      <span>▤</span>\n      <span>Sizing chart</span>\n    </summary>\n\n    <table>\n      <thead>\n        <tr>\n          <th>Size</th>\n          <th>Chest</th>\n          <th>Length</th>\n          <th>Shoulder</th>\n        </tr>\n      </thead>\n\n      <tbody>\n        <tr>\n          <td>S</td>\n          <td>42</td>\n          <td>27</td>\n          <td>20</td>\n        </tr>\n\n        <tr>\n          <td>M</td>\n          <td>44</td>\n          <td>28</td>\n          <td>21</td>\n        </tr>\n\n        <tr>\n          <td>L</td>\n          <td>46</td>\n          <td>29</td>\n          <td>22</td>\n        </tr>\n\n        <tr>\n          <td>XL</td>\n          <td>48</td>\n          <td>30</td>\n          <td>23</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <p style=\"font-size:12px;color:#777;\">\n      Measurements in inches.\n    </p>\n  </details>\n\n  <div class=\"bw-model-details\">\n    Model is 5'8\" (172 cm), 70 kg, Wearing M Size\n  </div>\n\n</div>"
