    "custom_liquid_6cjUKb": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n.bw-highlights {\n  width: 100%;\n  padding: 25px 0 40px;\n  overflow: hidden;\n}\n\n.bw-highlights-title {\n  text-align: center;\n  font-size: 16px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  margin: 0 0 20px;\n  text-transform: uppercase;\n}\n\n.bw-highlights-track {\n  display: flex;\n  gap: 3px;\n  overflow-x: auto;\n  scroll-snap-type: x mandatory;\n  scrollbar-width: none;\n}\n\n.bw-highlights-track::-webkit-scrollbar {\n  display: none;\n}\n\n.bw-highlight-card {\n  position: relative;\n  flex: 0 0 calc((100% - 9px) / 4);\n  min-width: 0;\n  overflow: hidden;\n  scroll-snap-align: start;\n}\n\n.bw-highlight-card img {\n  display: block;\n  width: 100%;\n  height: 550px;\n  object-fit: cover;\n}\n\n.bw-highlight-label {\n  position: absolute;\n  bottom: 25px;\n  right: 12px;\n  max-width: 85%;\n  background: #000;\n  color: #fff;\n  padding: 6px 10px;\n  font-size: 13px;\n  line-height: 1.3;\n  text-align: right;\n  text-transform: uppercase;\n}\n\n@media (max-width: 749px) {\n  .bw-highlight-card {\n    flex: 0 0 80%;\n  }\n\n  .bw-highlight-card img {\n    height: 440px;\n  }\n\n  .bw-highlights-title {\n    font-size: 14px;\n  }\n}\n</style>\n\n{% if product != blank and product.images.size > 0 %}\n<div class=\"bw-highlights\">\n  <h2 class=\"bw-highlights-title\">\n    KEY HIGHLIGHTS\n  </h2>\n\n  <div class=\"bw-highlights-track\">\n    {% for image in product.images limit: 4 %}\n      <div class=\"bw-highlight-card\">\n\n        <img\n          src=\"{{ image | image_url: width: 1000 }}\"\n          alt=\"{{ image.alt | escape }}\"\n          loading=\"lazy\"\n          width=\"{{ image.width }}\"\n          height=\"{{ image.height }}\"\n        >\n\n        <div class=\"bw-highlight-label\">\n          {% case forloop.index %}\n            {% when 1 %}\n              PREMIUM STREETWEAR FIT\n            {% when 2 %}\n              UNIQUE BACK ARTWORK\n            {% when 3 %}\n              SIGNATURE DESIGN DETAILS\n            {% when 4 %}\n              COMFORT MEETS STYLE\n          {% endcase %}\n        </div>\n\n      </div>\n    {% endfor %}\n  </div>\n</div>\n{% endif %}",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
